{
  "name": "flower-marketplace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && node scripts/copy-client-build.js",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:undo": "npm run db:migrate:undo -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
